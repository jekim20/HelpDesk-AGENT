# Non-secret runtime settings. Copy to /etc/helpdesk/aws-deploy.env; do not put credentials here.
AWS_REGION=ap-southeast-2
COMPOSE_PROJECT_NAME=helpdesk-agent
COMPOSE_FILE=/opt/helpdesk/compose.aws.yaml
HELPDESK_PGDATA_PATH=/data/postgres
HELPDESK_EBS_MOUNT=/data
HELPDESK_DB_NAME=helpdesk
HELPDESK_DB_USERNAME=helpdesk
DEMO_PORT=8080

# Create these SecureString parameters before deployment. No values belong in this file.
PARAM_DB_PASSWORD=/helpdesk/prod/db-password
PARAM_USER1_PASSWORD=/helpdesk/prod/user1-password
PARAM_USER2_PASSWORD=/helpdesk/prod/user2-password
PARAM_ADMIN_PASSWORD=/helpdesk/prod/admin-password
# Optional; leave empty until Live AI/RAG use is separately approved.
PARAM_OPENAI_API_KEY=

BACKUP_BUCKET=replace-with-private-ap-southeast-2-bucket
BACKUP_PREFIX=helpdesk/postgres
ECR_APP_REPOSITORY=replace-with-account.dkr.ecr.ap-southeast-2.amazonaws.com/helpdesk-backend
ECR_FRONTEND_REPOSITORY=replace-with-account.dkr.ecr.ap-southeast-2.amazonaws.com/helpdesk-frontend
EBS_VOLUME_ID=vol-replace-with-postgres-volume-id
HEALTH_TIMEOUT_SECONDS=300
