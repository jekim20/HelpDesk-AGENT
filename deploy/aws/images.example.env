# Copy to /etc/helpdesk/releases/<release>.env after CI pushes the images.
# Replace every digest with the exact linux/arm64 manifest digest from ECR.
HELPDESK_APP_IMAGE=replace-with-ecr-repository@sha256:replace-with-64-hex-digest
HELPDESK_FRONTEND_IMAGE=replace-with-ecr-repository@sha256:replace-with-64-hex-digest
HELPDESK_POSTGRES_IMAGE=postgres:17-alpine@sha256:replace-with-64-hex-digest
