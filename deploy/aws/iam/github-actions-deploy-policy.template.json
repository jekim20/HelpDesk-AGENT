{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendOnlyApprovedHelpDeskDocumentToInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:ACCOUNT_ID:document/HelpDesk-DeployRelease",
        "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:instance/INSTANCE_ID"
      ]
    },
    {
      "Sid": "ReadCommandResultForPolling",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
