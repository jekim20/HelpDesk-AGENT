{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SessionManagerChannels",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PullHelpDeskImages",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullOnlyHelpDeskRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/helpdesk-app",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/helpdesk-frontend"
      ]
    },
    {
      "Sid": "ReadOnlyNamedSecureParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/helpdesk/prod/db-password",
        "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/helpdesk/prod/user1-password",
        "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/helpdesk/prod/user2-password",
        "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/helpdesk/prod/admin-password"
      ]
    },
    {
      "Sid": "DecryptSecureParametersWithCustomerKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/helpdesk/prod/*"
        }
      }
    },
    {
      "Sid": "WriteAndReadOnlyHelpDeskBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/helpdesk/postgres/*"
    },
    {
      "Sid": "ListOnlyHelpDeskBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "helpdesk/postgres",
            "helpdesk/postgres/*"
          ]
        }
      }
    },
    {
      "Sid": "GetBackupBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET"
    },
    {
      "Sid": "VerifyAttachedEbsEncryption",
      "Effect": "Allow",
      "Action": "ec2:DescribeVolumes",
      "Resource": "*"
    }
  ]
}
